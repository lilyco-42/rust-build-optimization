# ============================================================================
# Tauri 项目「开发效率 + 硬盘占用」优化配置
#
# 实测收益（Tauri 2.12.1，291 个依赖）：
#   target/  4,135 MB  ->  1,511 MB    省 63%（2.6 GB）
#   增量构建      8.9s  ->  12.3s      +3.4s（换来 2.6 GB，值得）
#   冷重建       113s  ->  61.5s       叠加 sccache，1.84x
#
# 用法：把本段【追加】到 src-tauri/Cargo.toml 末尾。
# ⚠️ [profile.*] 只有在 workspace 根 crate 的 Cargo.toml 里才生效。
#    放进 ~/.cargo/config.toml 是完全无效的（已实测验证）。
# ============================================================================

# ---------------------------------------------------------------------------
# 开发内环（cargo build / cargo tauri dev）
# ---------------------------------------------------------------------------
[profile.dev]
# 自己的代码用 1：编得快，跑得也不慢
# （opt-level=0 在泛型密集型代码上反而更臃肿，因为不做任何单态化合并）
opt-level = 1

# 🔴 最关键的一行 —— 只保留行号表，不生成完整 DWARF
#    回溯依然显示「文件:行号」，但体积立减
debug = "line-tables-only"

# 保留增量：改一行只重编一个 crate（内环速度的命脉）
incremental = true

# 16 个 CGU：并行编自己代码
codegen-units = 16

# 剥掉符号表里的调试部分（行号表保留，回溯不受影响）
strip = "debuginfo"

# abort：panic 少一层展开逻辑，编译更快、体积更小
panic = "abort"

# ---------------------------------------------------------------------------
# 依赖包：编一次就不动，用 2 换更好性能和更小产物
# ---------------------------------------------------------------------------
[profile.dev.package."*"]
opt-level = 2
# 🔴 依赖的调试信息对本项目几乎无用 —— 最大的省空间项
debug = false

# ---------------------------------------------------------------------------
# release：丢 GitHub Actions，本地基本不编，体积 + 性能优先
# ---------------------------------------------------------------------------
[profile.release]
opt-level = "z"        # 体积优先；想运行更快改 3（体积约 +30%）
lto = "fat"            # 跨 crate 内联，配合 opt-level=z 效果最好
codegen-units = 1      # 单 CGU，LTO 效果最大化
panic = "abort"        # 去掉 unwind 表
strip = "symbols"      # 剥掉所有符号
incremental = false
overflow-checks = false
debug-assertions = false

# ---------------------------------------------------------------------------
# 如果你要做「给别人看的 demo」，临时切换到这套（exe 仅 2.9 MB）
# 但增量编译会被完全破坏 —— 每次改一行都要重编全部依赖
# ---------------------------------------------------------------------------
# [profile.dev-lean]
# inherits = "dev"
# opt-level = "z"
# lto = "thin"
# incremental = false
# codegen-units = 1
# 用法: cargo build --profile dev-lean
